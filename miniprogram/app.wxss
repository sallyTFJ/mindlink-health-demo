page{background:#fbfaf5;color:#273a37;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:28rpx 28rpx 60rpx}.card{background:#fff;border:1rpx solid #eeeae1;border-radius:32rpx;box-shadow:0 10rpx 40rpx rgba(80,74,60,.05)}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#d96a5e;font-weight:700}.primary{background:linear-gradient(135deg,#f48372,#f3a061);color:#fff;border-radius:24rpx;font-size:26rpx;font-weight:700}.secondary{background:#fff!important;color:#273a37!important;border:1rpx solid #e7e2d8;border-radius:24rpx;font-size:26rpx}.notice{background:#fff6d9;color:#776834;border:1rpx solid #f1e3a8;padding:18rpx 22rpx;border-radius:20rpx;font-size:22rpx}.muted{color:#7b8a86}.safe{padding-bottom:env(safe-area-inset-bottom)}
