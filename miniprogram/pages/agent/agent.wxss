.agent-page{min-height:calc(100vh - 88rpx);display:flex;flex-direction:column}.agent-hero{display:flex;gap:18rpx;align-items:center}.logo{width:76rpx;height:76rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#ffbd59,#f48372);color:#fff;font-size:36rpx}.agent-hero view:last-child{display:flex;flex-direction:column}.agent-title{font-size:32rpx;font-weight:800}.agent-hero .muted{font-size:21rpx}.messages{height:760rpx;margin:30rpx 0}.msg{max-width:82%;padding:22rpx 24rpx;border-radius:8rpx 28rpx 28rpx 28rpx;background:#fff;box-shadow:0 8rpx 30rpx rgba(80,74,60,.06);margin:20rpx 0;font-size:25rpx}.msg.user{margin-left:auto;background:#fff0e4;border-radius:28rpx 8rpx 28rpx 28rpx}.chips{display:flex;white-space:nowrap;overflow:auto;gap:12rpx;margin-bottom:16rpx}.chips text{border:1rpx solid #e7e2d8;background:#fff;padding:10rpx 16rpx;border-radius:99rpx;font-size:20rpx}.composer{display:flex;background:#fff;border:1rpx solid #e7e2d8;border-radius:24rpx;padding:10rpx}.composer input{flex:1;padding:10rpx}.composer button{margin:0;background:#f48372;color:#fff;font-size:23rpx;border-radius:18rpx}.disclaimer{text-align:center;color:#9aa3a1;font-size:18rpx;margin-top:12rpx}
