.title{display:block;font-size:46rpx;font-weight:800;margin-top:10rpx}.subtitle{display:block;color:#7b8a86;margin-bottom:28rpx}.upload{height:390rpx;border:2rpx dashed #e5b7a8;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#fff7ed,#fff)}.up{font-size:52rpx;color:#f48372}.upload-title{font-size:32rpx;font-weight:700}.upload .muted{font-size:22rpx}.upload button{width:260rpx;margin-top:24rpx}.tip{font-size:18rpx;color:#9aa3a1;margin-top:12rpx}.formats{padding:28rpx;margin-top:20rpx}.section-title{font-size:30rpx;font-weight:700}.formats view{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.formats view text{background:#edf7f3;color:#477d73;padding:10rpx 16rpx;border-radius:99rpx;font-size:20rpx}.notice{margin-top:20rpx}.files{margin-top:18rpx}.file{display:grid;grid-template-columns:72rpx 1fr auto;gap:16rpx;align-items:center;padding:20rpx;margin-top:12rpx}.file-icon{width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;background:#fff0ea;color:#d96a5e;border-radius:20rpx;font-size:18rpx;font-weight:700}.file view:nth-child(2){display:flex;flex-direction:column}.file .muted{font-size:19rpx}.ok{font-size:20rpx;color:#3e8175}
