.hello{display:flex;justify-content:space-between;align-items:center;margin:12rpx 0 28rpx}.hello view:first-child{display:flex;flex-direction:column}.title{font-size:46rpx;font-weight:800;letter-spacing:-2rpx;margin-top:8rpx}.subtitle{color:#7b8a86;font-size:24rpx}.avatar{width:74rpx;height:74rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#ffd97d,#f38778);color:#fff;font-weight:700}.sync{height:470rpx;margin-top:24rpx;display:flex;flex-direction:column;align-items:center;position:relative;overflow:hidden;background:radial-gradient(circle,#fff 0%,#fff1df 52%,#e6f5ef 100%)}.live{margin-top:30rpx;font-size:18rpx;font-weight:700;letter-spacing:2rpx}.dot{display:inline-block;width:12rpx;height:12rpx;border-radius:50%;background:#58ba8f;margin-right:10rpx}.score-ring{width:250rpx;height:250rpx;border-radius:50%;margin-top:28rpx;background:rgba(255,255,255,.82);box-shadow:0 20rpx 60rpx rgba(230,140,100,.16);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#71807d;font-size:22rpx}.score{font-size:100rpx;line-height:1;color:#273a37;font-weight:800}.sync-note{color:#3e8175;font-size:21rpx;margin-top:12rpx}.wave{position:absolute;bottom:6rpx;color:#ec8c78;font-size:68rpx;letter-spacing:-20rpx;opacity:.5}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:20rpx}.metric{height:220rpx;padding:26rpx;display:flex;flex-direction:column}.label{color:#7b8a86;font-size:22rpx}.value{font-size:56rpx;font-weight:800;line-height:1.5}.unit,.hint{font-size:20rpx;color:#899592}.hint{margin-top:auto}.bars{height:50rpx;display:flex;align-items:flex-end;gap:8rpx}.bars text{width:18rpx;height:32rpx;background:#f19577;border-radius:6rpx}.bars text:nth-child(2){height:48rpx}.bars text:nth-child(3){height:42rpx}.bars text:nth-child(4){height:25rpx}.insight{padding:28rpx;margin-top:20rpx}.insight-head{display:flex;justify-content:space-between}.tag{background:#f9e4b9;color:#996b2d;padding:8rpx 14rpx;border-radius:12rpx;font-size:18rpx;font-weight:700}.low{color:#398073;font-size:20rpx}.insight-title{display:block;font-size:32rpx;font-weight:700;margin:20rpx 0 8rpx}.insight .muted{display:block;font-size:23rpx}.ask{margin:18rpx 0 0;padding:0;text-align:left;background:transparent;color:#dc6559;font-size:23rpx;font-weight:700}.ask::after{border:0}.quick{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.quick button{margin:0}
